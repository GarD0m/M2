{
  "base_config": "maxtext-base.json",
  "model_name": "deepseek4-tiny",
  "override_model_config": true,
  "decoder_block": "deepseek4",
  "global_parameter_scale": 1,
  "base_num_decoder_layers": 2,
  "base_emb_dim": 2048,
  "base_mlp_dim": 6144,
  "base_moe_mlp_dim": 2048,
  "num_experts": 8,
  "num_experts_per_tok": 2,
  "shared_experts": 1,
  "routed_score_func": "sqrtsoftplus",
  "norm_topk_prob": true,
  "routed_bias": true,
  "routed_bias_update_rate": 0.001,
  "routed_scaling_factor": 1.5,
  "load_balance_loss_weight": 0.0001,
  "mlp_activations_limit": 10,
  "vocab_size": 65536,
  "base_num_query_heads": 16,
  "base_num_kv_heads": 1,
  "head_dim": 128,
  "qk_rope_head_dim": 64,
  "q_lora_rank": 512,
  "o_groups": 4,
  "o_lora_rank": 128,
  "mhc_expansion_rate": 4,
  "first_num_hash_layers": 0,
  "compress_ratios": [128, 4],
  "use_indexer": true,
  "indexer_head_dim": 64,
  "indexer_n_heads": 8,
  "indexer_topk": 128,
  "indexer_sparse_training": true,
  "indexer_loss_scaling_factor": 1.0,
  "sliding_window_size": 128,
  "mlp_activations": [
    "silu",
    "linear"
  ],
  "normalization_layer_epsilon": 1e-06,
  "use_qk_norm": true,
  "rope_max_timescale": 10000,
  "compressed_rope_max_timescale": 160000,
  "max_position_embeddings": 32768,
  "logits_via_embedding": true,
  "normalize_embedding_logits": false,
  "enable_dropout": false,
  "scan_layers": true,
  "remat_policy": "save_qkv_proj",
  "attention": "flash",
  "use_tokamax_splash": true,
  "sa_q_layout": "SEQ_MINOR",
  "sa_k_layout": "SEQ_MINOR",
  "sa_v_layout": "SEQ_MINOR",
  "eval_sa_q_layout": "SEQ_MINOR",
  "eval_sa_k_layout": "SEQ_MINOR",
  "eval_sa_v_layout": "SEQ_MINOR",
  "sa_use_fused_bwd_kernel": true,
  "sa_fuse_reciprocal": true,
  "sa_use_base2_exp": true,
  "fused_qkv": false,
  "fused_mlp": true,
  "attention_type": "compressed",
  "dtype": "bfloat16",
  "weight_dtype": "bfloat16",
  "grad_dtype": "float32",
  "mu_dtype": "float32",
  "logits_dot_in_fp32": true,
  "cast_logits_to_fp32": true,
  "num_vocab_tiling": 32,
  "opt_type": "muon",
  "muon_type": "optax_muon",
  "muon_beta": 0.95,
  "muon_consistent_rms": 0.2,
  "muon_weight_decay": 0.1,
  "adam_b1": 0.9,
  "adam_b2": 0.95,
  "adam_eps": 1e-08,
  "adam_weight_decay": 0.1,
  "gradient_clipping_threshold": 1.0,
  "learning_rate": 0.001,
  "lr_schedule_type": "wsd",
  "wsd_decay_steps_fraction": 0.0,
  "learning_rate_final_fraction": 1.0,
  "tokenizer_type": "huggingface",
  "dataset_type": "grain",
  "grain_file_type": "parquet",
  "hf_path": "openbmb/Ultra-FineWeb-L3",
  "tokenize_train_data": false,
  "tokenize_eval_data": false,
  "train_data_columns": [
    "text"
  ],
  "eval_data_columns": [
    "text"
  ],
  "packing": false,
  "add_bos": false,
  "add_eos": false,
  "num_epoch": 1,
  "enable_data_shuffling": false,
  "grain_worker_count": 0,
  "grain_worker_count_eval": 0,
  "grain_num_threads": 1,
  "grain_prefetch_buffer_size": 2,
  "enable_checkpointing": true,
  "async_checkpointing": false,
  "skip_jax_distributed_system": true,
  "save_checkpoint_on_completion": true,
  "checkpoint_period": 100,
  "save_checkpoint_on_start": false,
  "max_num_checkpoints_to_keep": 3,
  "log_period": 10,
  "eval_interval": 500,
  "eval_steps": 8,
  "eval_per_device_batch_size": 1.0,
  "ici_fsdp_parallelism": 1,
  "dcn_data_parallelism": 1
}
